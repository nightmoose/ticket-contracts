{
  "name": "ticketgate",
  "version": "0.1.0",
  "description": "Contract, grounding and PII checks on every field an AI agent writes to a Jira ticket",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:contracts": "node scripts/gen-contracts.mjs",
    "check:banned": "node scripts/check-banned.mjs",
    "lint": "forge lint",
    "ci": "npm run gen:contracts && git diff --exit-code src/contracts.generated.ts && npm run check:banned && npm run validate:manifest && npm run typecheck && npm test && npm run build:check",
    "validate:manifest": "node scripts/validate-manifest.cjs",
    "build:check": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/backend.js --log-level=warning && esbuild src/frontend/panel.tsx src/frontend/admin.tsx --bundle --platform=browser --format=esm --jsx=automatic --outdir=dist/frontend --log-level=warning",
    "demo": "tsx scripts/demo.ts"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@forge/cli": "^16.0.0",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@forge/api": "^8.5.1",
    "@forge/bridge": "^7.4.0",
    "@forge/kvs": "^2.1.3",
    "@forge/react": "^12.6.0",
    "@forge/resolver": "^2.0.2",
    "react": "^18.3.1",
    "yaml": "^2.9.1"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
