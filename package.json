{
  "name": "ticketgate",
  "version": "0.1.0",
  "description": "Contract, grounding and PII checks on every field an AI agent writes to a Jira ticket",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "gen:contracts": "node scripts/gen-contracts.mjs",
    "check:banned": "node scripts/check-banned.mjs",
    "lint": "forge lint",
    "ci": "npm run gen:contracts && git diff --exit-code src/contracts.generated.ts && npm run check:banned && npm run typecheck && npm test"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@forge/cli": "^16.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@forge/api": "^8.5.1",
    "@forge/bridge": "^7.4.0",
    "@forge/kvs": "^2.1.3",
    "@forge/react": "^12.6.0",
    "@forge/resolver": "^2.0.2",
    "js-yaml": "^4.3.2",
    "react": "^18.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
